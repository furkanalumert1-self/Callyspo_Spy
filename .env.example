# PostgreSQL (Supabase veya Neon)
DATABASE_URL=

# Redis (Upstash Redis önerilir - BullMQ için)
REDIS_URL=

# Apify (Authorization: Bearer header olarak kullanılır, ASLA URL query param değil)
APIFY_API_TOKEN=
# Opsiyonel: /api/webhooks/apify callback endpoint'ini korumak için paylaşımlı secret
APIFY_WEBHOOK_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Clerk
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# E-posta bildirimleri (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=AdSpy <notifications@yourdomain.com>

# Uygulama
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Worker (BullMQ) - opsiyonel, tek job'ın kaç eşzamanlı reklam işleyeceği
WORKER_CONCURRENCY=2
